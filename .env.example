# Copy to ".env" (cp .env.example .env) and fill in the blanks. ".env" is git-ignored: never commit it, never paste it into chat.
# These are placeholders only. Leave a value empty and Docker Compose tells you which one is missing.

# --- Database ---------------------------------------------------------------------------------------------------------
# Choose a long random password, for example:  openssl rand -hex 24   (letters and digits only: avoids characters that break connection strings)
# It is used when the database is FIRST created. Changing it later does not change the existing database's password.
POSTGRES_PASSWORD=
#POSTGRES_USER=techstore
#POSTGRES_DB=techstore
# The API connects with a separate, limited database user ("techstore_app"): it can read and write rows but cannot change the
# schema or use superuser features. The migration container creates it and keeps this password in sync on every start.
# Use a different random value from the one above:  openssl rand -hex 24
TECHSTORE_APP_DB_PASSWORD=

# --- First administrator ----------------------------------------------------------------------------------------------
# Needed ONLY for the very first start, when no Admin exists yet. At least 12 characters, at least 5 different characters,
# not a common word, and not containing the part of the email before the @.
# After you have signed in once, delete these two lines' values; the API ignores them and warns while they remain.
TECHSTORE_ADMIN_EMAIL=
TECHSTORE_ADMIN_PASSWORD=
#TECHSTORE_ADMIN_NAME=Administrator

# --- Optional ---------------------------------------------------------------------------------------------------------
# Port on this computer for the web site (http://localhost:8080 by default).
#TECHSTORE_WEB_PORT=8080
# Docker network used by the stack and the fixed address of the web container, which the API trusts for X-Forwarded-For.
# Change both together (the address must be inside the subnet) only if 172.28.0.0/24 clashes with another network of yours.
#TECHSTORE_SUBNET=172.28.0.0/24
#TECHSTORE_WEB_IP=172.28.0.10
